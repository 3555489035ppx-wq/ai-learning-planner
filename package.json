{
  "name": "ai-learning-planner",
  "private": true,
  "version": "1.0.0",
  "description": "AI personalized holiday learning planner portfolio demo",
  "engines": {
    "node": ">=22.6"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prepare-hosting.mjs",
    "preview": "vite preview",
    "lint": "eslint src tests e2e scripts *.config.ts *.config.js",
    "typecheck": "tsc -b --pretty false",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:unit": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:headed": "playwright test --headed",
    "test:visual": "node scripts/run-e2e.mjs e2e/visual-audit.spec.ts",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run test:unit && pnpm run test:e2e && pnpm run build"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.2",
    "@vitejs/plugin-react": "6.0.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router-dom": "7.18.1",
    "tailwindcss": "4.3.2",
    "typescript": "7.0.2",
    "vite": "8.1.4"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^8.0.1",
    "@babel/plugin-syntax-jsx": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1"
  }
}
